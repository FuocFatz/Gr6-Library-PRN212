<UserControl x:Class="PRN212.LibraryManagement.Controls.CustomerPortalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <TabControl Background="White">
        <TabItem Header="Danh mục sách">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Sách hiện có trong thư viện" FontSize="20" FontWeight="SemiBold" Foreground="#1E3A5F" />
                    <Button Content="Tải lại" DockPanel.Dock="Right" Click="RefreshBooks_Click" />
                </DockPanel>
                <DataGrid x:Name="BooksGrid" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sách" Binding="{Binding BookId}" Width="85" />
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*" />
                        <DataGridTextColumn Header="Thể loại" Binding="{Binding BookCategory}" Width="1.3*" />
                        <DataGridTextColumn Header="Còn lại" Binding="{Binding AvailableQuantity}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Lịch sử mượn của tôi">
            <Grid Margin="14">
                <DataGrid x:Name="HistoryGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã mượn" Binding="{Binding BorrowId}" Width="85" />
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*" />
                        <DataGridTextColumn Header="Ngày mượn" Binding="{Binding BorrowDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
