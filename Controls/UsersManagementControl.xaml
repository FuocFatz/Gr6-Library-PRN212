<UserControl x:Class="PRN212.LibraryManagement.Controls.UsersManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Quản lý tài khoản" FontSize="22" FontWeight="SemiBold" Foreground="#1E3A5F" />
                <TextBlock Text="Xem tài khoản và vai trò đã đăng ký ở màn hình đăng nhập."
                           Foreground="#64748B" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Tải lại" Click="Refresh_Click" />
                <Button Content="Xóa tài khoản" Background="#DC2626" Click="Delete_Click" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="UsersGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding UserId}" Width="65" />
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.2*" />
                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="1.6*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.8*" />
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
