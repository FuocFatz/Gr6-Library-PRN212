<UserControl x:Class="PRN212.LibraryManagement.Controls.BorrowRecordsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Theo dõi mượn - trả" FontSize="22" FontWeight="SemiBold" Foreground="#1E3A5F" />
                <TextBlock Text="Danh sách lượt mượn hiện có. Phần tạo phiếu và xác nhận trả sẽ được tích hợp cùng thành viên phụ trách nghiệp vụ."
                           TextWrapping="Wrap" Foreground="#64748B" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="Tải lại" DockPanel.Dock="Right" Click="Refresh_Click" />
        </DockPanel>
        <DataGrid x:Name="BorrowGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã mượn" Binding="{Binding BorrowId}" Width="80" />
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="1.4*" />
                <DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="1.8*" />
                <DataGridTextColumn Header="Ngày mượn" Binding="{Binding BorrowDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
