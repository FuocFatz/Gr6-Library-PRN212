<UserControl x:Class="PRN212.LibraryManagement.Controls.BookManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Quản lý sách" FontSize="22" FontWeight="SemiBold" Foreground="#1E3A5F" />
                <TextBlock Text="Thêm, sửa, xóa và tìm kiếm đầu sách trong thư viện."
                           Foreground="#64748B" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBox x:Name="TxtSearch" Width="220" Margin="0,0,4,0"
                         VerticalContentAlignment="Center" ToolTip="Nhập tên sách hoặc thể loại" />
                <Button Content="Tìm" Click="Search_Click" />
                <Button Content="Làm mới" Background="#475569" Click="Refresh_Click" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4,0,8,0">
                    <TextBlock Text="Tên sách" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtBookTitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="Thể loại" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtBookCategory" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                    <TextBlock Text="Tổng số lượng" FontWeight="SemiBold" />
                    <TextBox x:Name="TxtTotalQuantity" Text="1" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Thêm" Background="#15803D" Click="Add_Click" />
                    <Button Content="Cập nhật" Click="Update_Click" />
                    <Button Content="Xóa" Background="#DC2626" Click="Delete_Click" />
                    <Button Content="Bỏ chọn" Background="#64748B" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="BooksGrid" Grid.Row="2" SelectionChanged="BooksGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã sách" Binding="{Binding BookId}" Width="80" />
                <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*" />
                <DataGridTextColumn Header="Thể loại" Binding="{Binding BookCategory}" Width="1.3*" />
                <DataGridTextColumn Header="Tổng số" Binding="{Binding TotalQuantity}" Width="100" />
                <DataGridTextColumn Header="Còn lại" Binding="{Binding AvailableQuantity}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
