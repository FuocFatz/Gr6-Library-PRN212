<Window x:Class="PRN212.LibraryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRN212 - Đăng nhập thư viện"
        Height="760" Width="560" MinHeight="650" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="18" Padding="34" Margin="28"
                MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="LIBRARY MANAGEMENT" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="PRN212" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                           Margin="0,4,0,4" />
                <TextBlock Text="Hệ thống quản lý thư viện" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="Đăng nhập" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Tên đăng nhập" />
                    <TextBox x:Name="TxtLoginUsername" />
                    <TextBlock Text="Mật khẩu" />
                    <PasswordBox x:Name="PwbLoginPassword" />
                    <Button Content="ĐĂNG NHẬP" Height="42" Margin="0,10,0,8"
                            Click="Login_Click" />
                    <Button Content="Chưa có tài khoản? Tạo tài khoản demo"
                            Background="Transparent" Foreground="{StaticResource AccentBrush}"
                            Click="ShowRegister_Click" />
                    <Button Content="KIỂM TRA KẾT NỐI DATABASE" Height="34"
                            Background="#475569" Margin="0,8,0,0"
                            Click="TestDatabase_Click" />
                    <TextBlock Text="Tài khoản demo: tạo tại mục Đăng ký và chọn vai trò cần kiểm thử."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,15,0,0" />
                </StackPanel>

                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Tạo tài khoản demo" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Họ và tên" />
                    <TextBox x:Name="TxtFullName" />
                    <TextBlock Text="Email" />
                    <TextBox x:Name="TxtEmail" />
                    <TextBlock Text="Tên đăng nhập" />
                    <TextBox x:Name="TxtRegisterUsername" />
                    <TextBlock Text="Mật khẩu (ít nhất 6 ký tự)" />
                    <PasswordBox x:Name="PwbRegisterPassword" />
                    <TextBlock Text="Nhập lại mật khẩu" />
                    <PasswordBox x:Name="PwbConfirmPassword" />
                    <TextBlock Text="Vai trò dùng để demo" />
                    <ComboBox x:Name="CmbRole" SelectedIndex="2">
                        <ComboBoxItem Content="Admin" />
                        <ComboBoxItem Content="Librarian" />
                        <ComboBoxItem Content="Customer" />
                    </ComboBox>
                    <TextBlock Text="Lưu ý: Cho phép chọn cả 3 vai trò chỉ để demo bài tập. Ứng dụng thực tế phải giới hạn việc tạo Admin/Thủ thư."
                               TextWrapping="Wrap" Foreground="#9A3412" FontSize="11" Margin="0,0,0,10" />
                    <Button x:Name="BtnRegister" Content="TẠO TÀI KHOẢN" Height="42" Click="Register_Click" />
                    <Button Content="Quay lại đăng nhập" Background="Transparent"
                            Foreground="{StaticResource AccentBrush}" Click="ShowLogin_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
