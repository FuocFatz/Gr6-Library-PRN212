<Window x:Class="PRN212.LibraryManagement.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PRN212.LibraryManagement.Controls"
        Title="PRN212 - Khách hàng" Height="720" Width="1100" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="CUSTOMER PORTAL" Foreground="#BFDBFE" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="TxtWelcome" Text="Xin chào" Foreground="White"
                               FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Đăng xuất" Background="#DC2626"
                        VerticalAlignment="Center" Click="Logout_Click" />
            </DockPanel>
        </Border>
        <ContentControl x:Name="CustomerContent" Grid.Row="1" />
    </Grid>
</Window>
