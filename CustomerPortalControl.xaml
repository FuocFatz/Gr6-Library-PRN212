<UserControl x:Class="PRN212.LibraryManagement.Controls.CustomerPortalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <Grid>
        <TabControl x:Name="MainTabControl" Background="White">
            <!-- TAB 1: XEM DANH MỤC SÁCH -->
            <TabItem Header="Danh mục sách">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Sách hiện có trong thư viện" 
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" />

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearchBook" Width="230" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtSearchBook_TextChanged"
                                     ToolTip="Tìm theo tên sách hoặc thể loại..." />
                            <Button Content="Tải lại" Click="RefreshBooks_Click" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="BooksGrid" Grid.Row="1" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding BookId}" Width="85" />
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*" />
                            <DataGridTextColumn Header="Thể loại" Binding="{Binding BookCategory}" Width="1.3*" />
                            <DataGridTextColumn Header="Còn lại" Binding="{Binding AvailableQuantity}" Width="100" />
                            <DataGridTemplateColumn Header="Thao tác" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Mượn sách" Padding="10,4" Margin="2"
                                                Click="OpenBorrowModal_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: XEM LỊCH SỬ MƯỢN CỦA CHÍNH TÀI KHOẢN ĐANG ĐĂNG NHẬP -->
            <TabItem Header="Lịch sử mượn của tôi">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Lịch sử mượn sách cá nhân" 
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Tải lại" Click="RefreshHistory_Click" />
                    </DockPanel>

                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã mượn" Binding="{Binding BorrowId}" Width="85" />
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*" />
                            <DataGridTextColumn Header="Ngày mượn" Binding="{Binding BorrowDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Ngày trả" Binding="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thông báo hiển thị khi user chưa có lượt mượn nào -->
                    <TextBlock x:Name="TxtEmptyHistory" Grid.Row="1"
                               Text="Bạn chưa có lịch sử mượn sách nào."
                               Foreground="{StaticResource MutedBrush}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- HỘP THOẠI TẠO LƯỢT MƯỢN & THANH TOÁN (OVERLAY) -->
        <Grid x:Name="BorrowPaymentOverlay" Background="#800F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="24" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="XÁC NHẬN MƯỢN SÁCH &amp; THANH TOÁN"
                               FontSize="17" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,14" />

                    <TextBlock Text="Sách được chọn:" Foreground="#64748B" FontSize="12" />
                    <TextBlock x:Name="TxtModalBookTitle" Text="Tên sách"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Số ngày mượn:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CboBorrowDays" SelectionChanged="CboBorrowDays_SelectionChanged">
                                <ComboBoxItem Content="3 ngày" Tag="3" />
                                <ComboBoxItem Content="7 ngày" Tag="7" IsSelected="True" />
                                <ComboBoxItem Content="14 ngày" Tag="14" />
                                <ComboBoxItem Content="30 ngày" Tag="30" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Hạn trả dự kiến:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtModalDueDate" Text="23/11/2026"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Phương thức thanh toán:" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ComboBox x:Name="CboPaymentMethod">
                        <ComboBoxItem Content="Chuyển khoản ngân hàng (VietQR)" IsSelected="True" />
                        <ComboBoxItem Content="Ví điện tử (MoMo / ZaloPay)" />
                        <ComboBoxItem Content="Thanh toán tiền mặt tại quầy" />
                    </ComboBox>

                    <!-- Tổng tiền thanh toán -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,8,0,16">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Phí mượn (5.000đ/ngày):"
                                       VerticalAlignment="Center" Foreground="#475569" />
                            <TextBlock x:Name="TxtModalTotalFee" DockPanel.Dock="Right" Text="35.000 VNĐ"
                                       FontSize="18" FontWeight="Bold" Foreground="#DC2626" />
                        </DockPanel>
                    </Border>

                    <!-- Nút xác nhận / Hủy -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Background="#64748B" Margin="0,0,8,0"
                                Click="CancelBorrowModal_Click" />
                        <Button x:Name="BtnConfirmPayment" Content="Xác nhận &amp; Thanh toán"
                                Background="#16A34A" Click="ConfirmBorrowPayment_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
